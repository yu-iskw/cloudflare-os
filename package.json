{
  "name": "company-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "build": "NODE_OPTIONS=--experimental-strip-types vp run -r --cache build",
    "test": "NODE_OPTIONS=--experimental-strip-types vp run --filter '!company-os' --cache test",
    "dev-client": "cd packages/workshop-frontend && pnpm run dev",
    "dev-server": "pnpm --filter @gadgets/gcp-kernel start",
    "clean": "vp run -r clean",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "types:check": "pnpm run build",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run types:check",
    "assert-clean-tree": "node --experimental-strip-types scripts/assert-clean-tree.ts"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@types/node": "26.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
